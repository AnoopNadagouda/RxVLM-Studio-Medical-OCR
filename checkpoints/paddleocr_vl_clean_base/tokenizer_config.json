{
  "add_prefix_space": false,
  "auto_map": {
    "AutoProcessor": "processing_paddleocr_vl.PaddleOCRVLProcessor"
  },
  "backend": "tokenizers",
  "bos_token": "<s>",
  "clean_up_tokenization_spaces": false,
  "cls_token": "<|begin_of_sentence|>",
  "eos_token": "</s>",
  "image_token": "<|IMAGE_PLACEHOLDER|>",
  "is_local": true,
  "legacy": true,
  "local_files_only": false,
  "mask_token": "<mask:1>",
